<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/startLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pastel_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingTop="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/button_settings"
                    android:contentDescription="Ajustes"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:tint="#6A4D80" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulacro OPE SESPA"
                android:textSize="28sp"
                android:textColor="@color/ink"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/pointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Puntos: 0"
                android:textSize="20sp"
                android:textColor="@color/body"
                android:textStyle="bold" />

            <Button
                android:id="@+id/startButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/button_menu_item"
                android:text="EMPEZAR"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/resumePausedButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_soft_action"
                android:text="REANUDAR PAUSA"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/redeemButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_menu_item"
                android:text="CANJEAR"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <Button
                android:id="@+id/failuresButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_menu_item"
                android:text="FALLOS"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <Button
                android:id="@+id/doubtsButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_menu_item"
                android:text="DUDAS"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <Button
                android:id="@+id/newQuestionsButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_menu_item"
                android:text="NUEVAS"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <Button
                android:id="@+id/statisticsButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_menu_item"
                android:text="ESTADISTICAS"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />

            <Button
                android:id="@+id/badgesButton"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_menu_item"
                android:text="INSIGNIAS"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quizLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pastel_panel"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/exitQuizButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_soft_action"
                    android:text="Salir"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />

                <Button
                    android:id="@+id/pauseQuizButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_soft_action"
                    android:text="Pausar"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />

                <Button
                    android:id="@+id/nextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/button_menu_item"
                    android:text="Siguiente"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tiempo: 00:00"
                android:textSize="16sp"
                android:textColor="@color/muted"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pregunta 1/20"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/yearText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Año: 0000"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp"
                android:textColor="@color/ink"
                android:lineSpacingMultiplier="1.4"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:maxLines="9999"
                android:ellipsize="none" />

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/blankButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_soft_action"
                    android:text="Dejar vacía"
                    android:textAllCaps="false"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <Button
                android:id="@+id/copyPromptButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_soft_action"
                android:text="Preguntar a IA"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/feedbackText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/resultLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/pastel_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                android:id="@+id/resultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resultado"
                android:textSize="26sp"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0/20"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/netasText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="NETAS: 0.00"
                android:textSize="30sp"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/finalTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tiempo: 00:00"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/earnedPointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Has ganado 0 puntos"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/downloadCsvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/button_soft_action"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:drawablePadding="8dp"
                android:text="Descargar y compartir CSV"
                android:textAllCaps="false"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/restartButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_soft_action"
                android:text="Volver a empezar"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
