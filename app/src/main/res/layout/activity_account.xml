<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_anim"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pastel_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/accountBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_soft_action"
            android:text="← Volver"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cuenta y sincronización"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/accountStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estado de cuenta"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Acceso con correo"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Contraseña"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/emailLoginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_soft_action"
            android:text="Entrar con correo"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/emailRegisterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_soft_action"
            android:text="Crear cuenta con correo"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Acceso con Google"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/googleSignInButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_soft_action"
            android:text="Entrar con Google"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/syncNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_soft_action"
            android:text="Sincronizar ahora"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/signOutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_soft_action"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
