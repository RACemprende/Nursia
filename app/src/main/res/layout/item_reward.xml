<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/reward_card_background"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/rewardImage"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="Imagen del premio"
        android:scaleType="centerCrop"
        android:src="@drawable/app_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rewardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Premio"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rewardCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Coste: 0 puntos"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/buyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_soft_action"
        android:text="Comprar"
        android:textAllCaps="false"
        android:textColor="@color/ink" />
</LinearLayout>

