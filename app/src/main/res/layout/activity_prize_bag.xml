<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_anim"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/pastel_panel"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/bagBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_soft_action"
            android:text="← Volver"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mi mochila"
            android:textColor="@color/ink"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/bagEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="No tienes premios sin canjear."
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bagRewardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
